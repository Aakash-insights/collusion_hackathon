# Copy to .env and fill in. Both games (Collusion_Liars_Bar and Collusion_Cleanup)
# read this file from the project root.
#
# All model calls go through OpenRouter. Each of the four agents runs a different
# model; the mapping from short names to OpenRouter ids lives in each game's
# llm_client.py (see README, "Models").
OPENROUTER_API_KEY=<your-key>
