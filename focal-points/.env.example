# Inference is configured centrally — set NEBIUS_API_KEY in the repo-root compute.env (see COMPUTE.md).

# Default model = the paper's default (Llama-3.3-70B-Instruct). Any model id the shared config can
# resolve works, e.g. openai/gpt-4o · qwen/qwen2.5-72b-instruct · google/gemini-2.5-flash
#   · meta-llama/llama-3.1-8b-instruct (much cheaper). Pass it with `-m <id>`.
MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# Calls per run = prompts × samples per prompt (-s). The script prints the count and asks before spending.
