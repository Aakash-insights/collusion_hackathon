# ========================= Hackathon compute config (ONE place) =========================
# Copy to `compute.env` (same dir) and fill it in. Every project reads it through
# util/llm_config.py. compute.env is gitignored — never commit your keys.

# --- Inference: Nebius AI Studio (default) -------------------------------------------------------
NEBIUS_API_KEY=

# Optional: pick ONE model for every project (use an exact Nebius model id).
# If you choose a model Nebius doesn't serve, run the experiment via `python -m util.run` — it hosts
# that model on Modal for the run. No model is ever silently substituted.
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
