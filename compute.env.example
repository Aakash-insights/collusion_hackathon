# ========================= Hackathon compute config (ONE place) =========================
# Copy to `compute.env` (same dir) and fill it in. Every project reads it through llm_config.py,
# and modal_run.py uses it for cloud runs. compute.env is gitignored — never commit your keys.

# --- Inference: Nebius AI Studio (default) -------------------------------------------------------
NEBIUS_API_KEY=

# Optional: force ONE model id across every project (else each project's default is auto-mapped to
# a Nebius-served model). e.g. meta-llama/Llama-3.3-70B-Instruct
# LLM_MODEL=

# Optional: fallback model when a project's default has no Nebius equivalent
# NEBIUS_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Inference via a Modal-hosted model (fallback for experiments Nebius can't serve) ------------
# Deploy modal_serve.py (`modal deploy modal_serve.py`), then point inference at that endpoint:
# LLM_BASE_URL=https://<your-modal-app>.modal.run/v1
# LLM_API_KEY=                 # the key you set on the Modal endpoint (if any)
# LLM_MODEL=<the model you served on Modal>
