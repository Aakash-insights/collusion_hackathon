# ========================= Hackathon compute config (ONE place) =========================
# Copy this file to `compute.env` (same dir) and fill it in. Every project reads it through
# llm_config.py, and modal_run.py uses it for cloud runs. compute.env is gitignored — never
# commit your keys.

# Inference provider every project uses:  openrouter | nebius
LLM_PROVIDER=openrouter

# Keys — fill the one(s) you use
OPENROUTER_API_KEY=
NEBIUS_API_KEY=

# Optional: force ONE model id across all projects (else each project's default is used and,
# on Nebius, auto-mapped to a served model). e.g. meta-llama/Llama-3.3-70B-Instruct
# LLM_MODEL=

# Optional: fallback Nebius model when a project's default is OpenAI/Gemini-only
# NEBIUS_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct
