# ========================= Hackathon compute config (ONE place) =========================
# Copy to `compute.env` (same dir) and fill it in. Every project reads it through
# poseidon_compute. compute.env is gitignored — never commit your keys.

# --- Inference: Nebius AI Studio (default) -------------------------------------------------------
NEBIUS_API_KEY=

# --- Inference fallback: OpenRouter (optional) ---------------------------------------------------
# Lets `poseidon-run` reach models Nebius doesn't serve — including closed ones (GPT/Gemini/
# Claude). Routing is Nebius -> OpenRouter -> Modal -> fail. Leave blank to skip OpenRouter.
OPENROUTER_API_KEY=

# Optional: pick ONE model for every project (an exact Nebius / Hugging Face model id).
# If you choose a model Nebius doesn't serve, run the experiment via `poseidon-run` — it uses
# OpenRouter if it has the model, else hosts it on Modal for the run. No model is ever silently substituted.
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
