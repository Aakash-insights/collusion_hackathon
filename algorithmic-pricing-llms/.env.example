# All model calls go through OpenRouter with ONE key.
# Get a key at https://openrouter.ai/keys ; per-model rates at https://openrouter.ai/models
OPENROUTER_API_KEY=<your-key>

# Default = current Mistral Large (the thesis used mistral-large-2411, which OpenRouter no
# longer serves). Any OpenRouter model id works, e.g.
#   mistralai/mistral-large-2407              closest to the thesis model (4x the price)
#   mistralai/mistral-small-3.2-24b-instruct  much cheaper
#   openai/gpt-4.1-mini · google/gemini-2.5-flash · qwen/qwen3-14b
MODEL_NAME=mistralai/mistral-large-2512

# A 300-round duopoly run = ~600 model calls. Scripts print the count and ask before spending.
