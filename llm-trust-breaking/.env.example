# ============================================================================
# This file is for PER-PROJECT OVERRIDES only. Inference keys/provider live in
# the repo-root compute.env (one level up) -- see ../COMPUTE.md.
#   cp ../compute.env.example ../compute.env   # then set NEBIUS_API_KEY
#   #   add OPENROUTER_API_KEY too if you run a closed model (GPT / Claude / Gemini)
# ============================================================================
# MODEL CHOICE: agent decisions are read back as structured JSON via the
# response_format parameter, so pick a model that supports it. GPT / Claude via
# OpenRouter qualify, as do many Nebius models. A non-OpenAI model is accepted
# (a warning prints) rather than rejected -- the old OpenAI-only gate is now
# advisory. If a model cannot honor response_format, decisions may parse as
# EMPTY, so check the run output before trusting it. Choose the model per run
# with `python -m util.run --model <id> -- ...` (or the runner's --model flag).
# ============================================================================

# Sampling temperature
# Default when unset: 1.0
TEMPERATURE=0.7

# Reasoning Model Configuration (only for o1/o3/gpt-5 models)
# Controls how much reasoning the model does before generating output
# Valid values: "low", "medium", "high"
# Higher effort = more reasoning tokens = better quality but slower/more expensive
# Default when unset: "low"
REASONING_EFFORT=medium

# Game Configuration
NUM_AGENTS=5
