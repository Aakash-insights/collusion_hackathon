# ============================================================================
# SUPPORTED MODELS: OpenAI only (gpt-*, o1*, o3*)
# ============================================================================
# Agent decisions are read back as structured JSON via the response_format
# parameter, and this codebase only enables that path for OpenAI models.
# Any other provider (Anthropic, Llama, Mistral, ...) silently falls back to
# asking for JSON inside the prompt, which yields empty decisions instead of an
# error — the run completes and the output data is unusable.
# Do not point the model vars below at a non-OpenAI model.

# OpenRouter Configuration (every model call goes through OpenRouter)
OPENROUTER_API_KEY=your-openrouter-key-here
# Model used when no --model is passed on the command line
# Must be an OpenAI model — see SUPPORTED MODELS above
# Examples: openai/gpt-4o-mini, openai/gpt-4o, openai/gpt-4-turbo
# Default when unset: gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# Sampling temperature
# Default when unset: 1.0
TEMPERATURE=0.7

# Reasoning Model Configuration (only for o1/o3/gpt-5 models)
# Controls how much reasoning the model does before generating output
# Valid values: "low", "medium", "high"
# Higher effort = more reasoning tokens = better quality but slower/more expensive
# Default when unset: "low"
REASONING_EFFORT=medium

# Game Configuration
NUM_AGENTS=5
