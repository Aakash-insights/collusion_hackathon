# All model calls go through OpenRouter with ONE key.
# Get a key at https://openrouter.ai/keys ; per-model rates at https://openrouter.ai/models
OPENROUTER_API_KEY=<your-key>

# Models are given on the command line. The paper's names are aliases for OpenRouter ids:
#   gpt-4.1 (default) -> openai/gpt-4.1        gpt-4.1-mini -> openai/gpt-4.1-mini (overseer / judge)
#   claude-3-7-sonnet-latest -> anthropic/claude-3.7-sonnet     gemini-2.5-flash-preview-04-17 -> google/gemini-2.5-flash
# Any other OpenRouter id works too, e.g. --seller_models qwen/qwen3-14b

# Cost: one call per LLM agent per round (+1 per round with --oversight_enabled). The default
# 3 sellers + 3 buyers x 15 rounds = 90 calls; the paper's 5+6 x 30 = 330. Scripts ask before spending.
