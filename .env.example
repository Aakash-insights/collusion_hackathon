# Here we define our environment variables for the development environment
# Every entry will have an annotation to explain which project it is used for. 
# You can add more variables as needed.

# Default Variables as fallback for all projects
# These variables are used as defaults for all projects.

DEFAULT_OPENAI_API_KEY=your-api-key-here

DEFAULT_OPENROUTER_API_KEY=your-openrouter-key-here

# Project-specific Variables
# These variables are optional, fallback to DEFAULT_* if not set.

# These variables are specific to the llm-trust-breaking project.
TRUST_BREAKING_OPENAI_API_KEY=your-api-key-here

TRUST_BREAKING_OPENROUTER_API_KEY=your-openrouter-key-here