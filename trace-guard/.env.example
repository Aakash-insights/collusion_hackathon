# Copy to .env and fill in. Loaded from this directory by explicit path.

# Required. Every model call -- untrusted agent, trusted monitor, post-hoc scoring,
# intent analysis -- goes through OpenRouter.
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional: enable the intent analyzer (a second-opinion pass by Claude Opus that runs
# only when the heuristic detectors flag something). Disabled when unset, as shipped.
# The original project used Claude Opus 4.6 via AWS Bedrock; the same model is on
# OpenRouter. Any inspect-ai model string works here if you want a different one
# (e.g. openrouter/anthropic/claude-opus-4.5) -- see the README note on cost.
# INTENT_MODEL=openrouter/anthropic/claude-opus-4.6

# Optional: model used by scripts/run_posthoc.py when --model is not given.
# INSPECT_EVAL_MODEL=openrouter/openai/gpt-4o-mini
