# All model calls go through OpenRouter with ONE key.
# Get a key at https://openrouter.ai/keys ; per-model rates at https://openrouter.ai/models
OPENROUTER_API_KEY=<your-key>

# Default model in the hackathon configs = openai/gpt-4o-mini (used by the paper's persuasion and
# misalignment configs). Change `openrouter.model` in a config to any OpenRouter id, e.g.
#   openai/gpt-4.1-mini · google/gemini-2.5-flash · qwen/qwen3-14b · moonshotai/kimi-k2
# The model must support tool calling (Terrarium agents act through tools).

# CoLLAB is vendored under external/CoLLAB and found automatically; set this only if you moved it.
# TERRARIUM_COLLAB_PATH=external/CoLLAB
